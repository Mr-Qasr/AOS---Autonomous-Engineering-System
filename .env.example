# AOS local development environment
# Copy this to .env and fill in secrets before running.

AOS_DATABASE_URL=postgresql+asyncpg://aos_user:aos_password@localhost:5432/aos_db
AOS_SYNC_DATABASE_URL=postgresql+psycopg://aos_user:aos_password@localhost:5432/aos_db
AOS_CONTROLLER_ID=local-dev-controller-01
AOS_LEASE_TTL_SECONDS=30
